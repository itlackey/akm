{
  "description": "Everything default runs, plus a triage drain of the pending-proposal backlog (up to 25 accepts per run). Auto-accepts only when improve autonomy is enabled; otherwise proposals queue for review. Identical tuning to default; improve-stage extract and proactive maintenance stay off.",
  "processes": {
    "reflect": {
      "enabled": true,
      "limit": 25,
      "allowedTypes": ["agent", "command", "knowledge", "lesson", "memory", "skill", "workflow"]
    },
    "distill": {
      "enabled": true,
      "allowedTypes": ["memory"],
      "requirePlannedRefs": false
    },
    "consolidate": {
      "enabled": true,
      "allowedTypes": ["memory"]
    },
    "memoryInference": {
      "enabled": true
    },
    "extract": {
      "enabled": false,
      "triage": {
        "enabled": true,
        "minScore": 2
      }
    },
    "validation": {
      "enabled": true
    },
    "proactiveMaintenance": {
      "enabled": false,
      "dueDays": 30,
      "maxPerRun": 15
    },
    "triage": {
      "enabled": true,
      "applyMode": "promote",
      "policy": "personal-stash",
      "maxAcceptsPerRun": 25,
      "maxDiffLines": 200,
      "judgment": false
    }
  },
  "sync": {
    "enabled": true,
    "push": true
  }
}
