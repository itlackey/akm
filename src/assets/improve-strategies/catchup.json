{
  "description": "Manual catch-up \u2014 consolidation plus a judged triage drain (up to 100 accepts) with no interval minimum. Auto-accepts only when improve autonomy is enabled; otherwise proposals queue for review.",
  "processes": {
    "reflect": {
      "enabled": false
    },
    "distill": {
      "enabled": false
    },
    "consolidate": {
      "enabled": true,
      "allowedTypes": ["memory"],
      "maxChunkSize": 50
    },
    "memoryInference": {
      "enabled": false
    },
    "extract": {
      "enabled": false
    },
    "triage": {
      "enabled": true,
      "applyMode": "promote",
      "policy": "personal-stash",
      "maxAcceptsPerRun": 100,
      "judgment": true,
      "maxDiffLines": 200
    },
    "validation": {
      "enabled": false
    },
    "proactiveMaintenance": {
      "enabled": false
    }
  },
  "sync": {
    "enabled": true,
    "push": true
  }
}
