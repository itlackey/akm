{
  "extends": "$app/tsconfig",
  "include": ["src", "electron", "scripts", "vite.config.ts"],
  "exclude": ["build", "out", ".core", "src/service-worker"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler"
  }
}
