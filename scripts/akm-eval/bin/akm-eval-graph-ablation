#!/usr/bin/env bash
# akm-eval-graph-ablation — retired entry point.
#
# Drove a graph A/B ablation (indexes + improves the same source stash twice,
# graph extraction on / off, and compares retrieval). The LLM graph it
# ablated was retired in 0.9.17-alpha.9, so the comparison this harness made
# is no longer possible. src/graph-ablation.ts is kept, unreachable, as a
# historical reference; this entry point refuses instead of running it.

set -euo pipefail

echo "akm-eval-graph-ablation: the LLM graph was retired in 0.9.17-alpha.9; there is nothing left to ablate." >&2
exit 1
