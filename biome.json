{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/*.ts",
      "!src/vendor/**",
      "!tests/fixtures/goldens/**/*.json",
      "!tests/fixtures/format-family-goldens/**/*.json",
      "!.claude/**",
      "desktop/**",
      "!desktop/**/*.svelte",
      "!desktop/node_modules",
      "!desktop/.core",
      "!desktop/.core.json",
      "!desktop/.svelte-kit",
      "!desktop/build",
      "!desktop/out",
      "!desktop/test-results",
      "!desktop/playwright-report",
      "!desktop/src/lib/ui/echarts.js",
      "!desktop/docs/prototypes",
      "!desktop/spikes/*/node_modules",
      "!desktop/spikes/*/dist",
      "!desktop/spikes/*/public"
    ],
    "experimentalScannerIgnores": [
      ".claude"
    ]
  },
  "overrides": [
    {
      "includes": [
        "tests/integration/env/env-path-run.test.ts",
        "tests/integration/env/env-run.test.ts",
        "tests/integration/workflows/native-executor.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": [
        "desktop/src/lib/ui/**/*.css"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "error"
          },
          "complexity": {
            "noImportantStyles": "error"
          },
          "nursery": {
            "noDuplicateSelectors": "error"
          }
        }
      }
    }
  ]
}
